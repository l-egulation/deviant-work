# Deviant work repo attributes (see docs/specs/2026-11-03-repo-structure-design.md 5.5)

# Line endings: normalize text files only. Images are not touched.
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Git LFS: only new work folders. archive/ and assets/work/characters/ stay as plain Git files.
assets/work/motion-lab/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/work/motion-lab/**/*.gif filter=lfs diff=lfs merge=lfs -text
